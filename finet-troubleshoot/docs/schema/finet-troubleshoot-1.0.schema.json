{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/finet-troubleshoot-1.0.schema.json",
  "title": "Finet Troubleshoot import 1.0",
  "type": "object",
  "required": ["schema", "schema_version", "guides"],
  "properties": {
    "schema": { "const": "finet-troubleshoot" },
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "guides": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/guide" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
    "guide": {
      "type": "object",
      "required": ["external_id", "title", "slug", "start_node", "nodes"],
      "properties": {
        "external_id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "slug": { "$ref": "#/$defs/id" }, "description": { "type": "string" },
        "status": { "enum": ["publish", "draft", "private"] }, "start_node": { "$ref": "#/$defs/id" }, "settings": { "type": "object" }, "variables": { "type": "object" },
        "nodes": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/node" } }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object", "required": ["id", "type", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["information", "action", "question", "check", "result", "support"] }, "title": { "type": "string", "minLength": 1 }, "heading": { "type": "string" }, "intro": { "type": "string" }, "content": { "type": "string" }, "button_text": { "type": "string" }, "next": { "$ref": "#/$defs/id" },
        "image": { "type": ["object", "null"], "properties": { "url": { "type": "string", "format": "uri" }, "alt": { "type": "string" } }, "additionalProperties": false },
        "options": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/option" } }, "result_type": { "enum": ["success", "info", "warning", "failure"] },
        "support": { "type": "object", "properties": { "inherit_global": { "type": "boolean" }, "phone": { "type": "string" }, "email": { "type": "string", "format": "email" }, "url": { "type": "string", "format": "uri" }, "opening_hours": { "type": "string" } }, "additionalProperties": false }, "meta": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["question", "check"] } } }, "then": { "required": ["options"], "properties": { "options": { "minItems": 1 } } } },
        { "if": { "properties": { "type": { "const": "result" } } }, "then": { "required": ["result_type"] } }
      ],
      "additionalProperties": true
    },
    "option": { "type": "object", "required": ["id", "label", "next"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1 }, "next": { "$ref": "#/$defs/id" }, "style": { "enum": ["primary", "secondary", "success", "warning", "danger"] }, "icon": { "type": "string" } }, "additionalProperties": true }
  }
}
