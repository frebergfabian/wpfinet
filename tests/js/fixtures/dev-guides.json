[{"guide_id": 6615, "guide_external_id": "internet-fungerar-inte", "title": "Internet fungerar inte", "description": "Steg-för-steg-felsökning för internetanslutning.", "start_node": "start", "nodes": [{"id": "start", "type": "information", "title": "Start", "heading": "Vi felsöker din internetanslutning", "intro": "", "content": "<p>Guiden hjälper dig att kontrollera de vanligaste orsakerna till att internetanslutningen inte fungerar. Följ stegen i ordning och välj det svar som bäst beskriver resultatet.</p>", "image": null, "icon": "", "button_text": "Starta felsökningen", "next": "question-ycjaxxn", "options": [], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 120, "y": 120}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "problem-scope", "type": "question", "title": "Problemets omfattning", "heading": "Hur ser problemet ut?", "intro": "", "content": "<p>Är internet helt nere eller fungerar anslutningen på vissa enheter?</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [{"id": "all-devices", "label": "Internet fungerar inte på någon enhet", "next": "check-outage", "style": "primary", "icon": ""}, {"id": "wifi-only", "label": "Problemet gäller bara WiFi", "next": "wifi-or-cable", "style": "primary", "icon": ""}, {"id": "one-device", "label": "Problemet gäller bara en enhet", "next": "single-device", "style": "primary", "icon": ""}], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 380, "y": 120}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "wifi-or-cable", "type": "information", "title": "Kontrollera WiFi eller kabel", "heading": "Låt oss avgöra om det gäller WiFi eller internetanslutningen", "intro": "", "content": "<p>Om möjligt testar vi först med en nätverkskabel. Då kan vi skilja ett trådlöst problem från ett problem med själva internetanslutningen.</p>", "image": null, "icon": "", "button_text": "Testa med kabel", "next": "test-ethernet", "options": [], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 640, "y": 120}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "check-outage", "type": "check", "title": "Kontrollera driftstörning", "heading": "Kontrollera om det finns en känd driftstörning", "intro": "", "content": "<p>Kontrollera eventuell driftinformation från din internetleverantör. Om det finns en pågående störning i området behöver du normalt inte ändra något i din utrustning.</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [{"id": "outage", "label": "Det finns en driftstörning", "next": "known-outage", "style": "primary", "icon": ""}, {"id": "no-outage", "label": "Ingen känd driftstörning", "next": "reboot-equipment", "style": "primary", "icon": ""}], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 900, "y": 120}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "known-outage", "type": "result", "title": "Känd driftstörning", "heading": "Avvakta tills driftstörningen är åtgärdad", "intro": "", "content": "<p>Din utrustning behöver sannolikt inte felsökas ytterligare just nu. Kontrollera driftinformationen igen senare.</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 120, "y": 310}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "reboot-equipment", "type": "action", "title": "Starta om utrustningen", "heading": "Har du startat om tjänstefördelaren och din övriga utrustning?", "intro": "", "content": "<p>Starta om tjänstefördelaren genom att dra ut dess strömadapter ur eluttaget i väggen. Vänta cirka 5 minuter innan du kopplar in allt igen. Starta även om din inkopplade enhet, till exempel routern, på samma sätt.</p>", "image": {"url": "https://dev.finet.se/wp-content/uploads/2026/11/wpfinet-router-strom.png", "alt": "Router med strömadapter ansluten till ett eluttag.", "caption": "", "placement": "above_heading", "zoom": true}, "icon": "", "button_text": "Utrustningen är omstartad", "next": "test-after-reboot", "options": [], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 380, "y": 310}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "test-after-reboot", "type": "check", "title": "Kontroll efter omstart", "heading": "Fungerar internet nu?", "intro": "", "content": "<p>Testa anslutningen på en enhet.</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [{"id": "yes", "label": "Ja", "next": "success-reboot", "style": "primary", "icon": ""}, {"id": "no", "label": "Nej", "next": "check-router-lights", "style": "primary", "icon": ""}], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 640, "y": 310}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "success-reboot", "type": "result", "title": "Internet fungerar efter omstart", "heading": "Internetanslutningen fungerar igen", "intro": "", "content": "<p>Problemet verkar ha lösts genom omstarten. Du behöver inte göra något mer.</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [], "css_class": "", "result_type": "success", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 900, "y": 310}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "check-router-lights", "type": "check", "title": "Routerlampor", "heading": "Kontrollera lamporna på routern", "intro": "", "content": "<p>Kontrollera att routern har ström och att WAN- eller internetindikeringen ser normal ut. Exakt märkning varierar mellan olika routermodeller.</p><p>Har routern ström och visar den någon WAN/internetanslutning?</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [{"id": "yes", "label": "Ja", "next": "test-ethernet", "style": "primary", "icon": ""}, {"id": "no", "label": "Nej", "next": "check-cables", "style": "primary", "icon": ""}, {"id": "unknown", "label": "Jag vet inte", "next": "check-cables", "style": "primary", "icon": ""}], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 120, "y": 500}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "check-cables", "type": "check", "title": "Kontrollera kablar", "heading": "Kontrollera kablaget", "intro": "", "content": "<p>Kontrollera att nätverkskabeln mellan fiberbox, nätverksuttag eller medieomvandlare och routerns WAN-port sitter ordentligt ansluten.</p><p>Koppla gärna ur och anslut kabeln igen i båda ändarna.</p><p>Ser kablaget rätt ut och sitter alla kontakter ordentligt?</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [{"id": "yes", "label": "Ja", "next": "try-other-cable", "style": "primary", "icon": ""}, {"id": "loose", "label": "Nej, en kabel satt löst", "next": "reconnect-test", "style": "primary", "icon": ""}], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 380, "y": 500}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "reconnect-test", "type": "check", "title": "Test efter återanslutning", "heading": "Fungerar internet efter att kablarna anslutits igen?", "intro": "", "content": "<p>Vänta någon minut medan anslutningen kommer tillbaka.</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [{"id": "yes", "label": "Ja", "next": "success-cable", "style": "primary", "icon": ""}, {"id": "no", "label": "Nej", "next": "try-other-cable", "style": "primary", "icon": ""}], "css_class": "", "result_type": "info", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 640, "y": 500}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "success-cable", "type": "result", "title": "Kabelanslutningen löste problemet", "heading": "Problemet är löst", "intro": "", "content": "<p>Felet verkar ha berott på anslutningen mellan utrustningen.</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [], "css_class": "", "result_type": "success", "support": {"inherit_global": true, "phone": "", "email": "", "url": "", "opening_hours": ""}, "editor_position": {"x": 900, "y": 500}, "ctas": [], "wpforms": {"form_id": 0, "form_title": "", "embedded": false}, "outage": {"service": "", "provider": "", "area": "", "match_node": "", "no_match_node": "", "mode": "show"}, "meta": [], "form_html": "", "cta_forms": []}, {"id": "try-other-cable", "type": "check", "title": "Annan nätverkskabel", "heading": "Testa en annan nätverkskabel", "intro": "", "content": "<p>Om du har möjlighet, byt kabeln mellan inkommande anslutning och router.</p><p>Fungerar internet med den andra kabeln?</p>", "image": null, "icon": "", "button_text": "Fortsätt", "next": "", "options": [{"id": "yes", "label": "Ja", "next": "success-bad-cable", "style": "primary", "icon": ""}, {"id": "no", "label": "Nej", "next": "test-ethernet", "style": "primary", "icon": ""}, {"id": "no-cable", "label": "Jag har ingen annan kabel", "next": "test-ethernet", "style": "primary", "icon": ""}], "css_class": "", "result_type": "info", "support": {