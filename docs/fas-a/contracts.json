  "post_types": {
    "finet_ts_guide": { "public": false, "rest": true, "rewrite": false, "meta": ["_finet_ts_external_id", "_finet_ts_start_node", "_finet_ts_nodes", "_finet_ts_settings", "_finet_ts_schema_version"] },
    "wpfinet_outage": { "public": true, "rest": true, "archive": "/driftstorningar/", "single": ["/driftstorningar/{Y}/{m}/{d}/{post_name}/", "/driftstorningar/{post_name}/"], "meta": ["_wpfinet_incident_type", "_wpfinet_outage_status", "_wpfinet_incident_start", "_wpfinet_estimated_end", "_wpfinet_actual_end", "_wpfinet_priority", "_wpfinet_banner", "_wpfinet_timeline", "_wpfinet_area_note", "_wpfinet_internal_note", "_wpfinet_external_id"] }
  },
  "taxonomies": ["wpfinet_provider", "wpfinet_service", "wpfinet_area"],
  "enums": {
    "node_types": ["information", "action", "question", "check", "result", "support", "outage", "wpforms"],
    "result_types": ["success", "info", "warning", "failure"],
    "cta_types": ["phone", "email", "wpforms", "url", "support", "restart", "back", "internal"],
    "outage_status": ["scheduled", "investigating", "identified", "in_progress", "monitoring", "resolved", "cancelled"],
    "incident_type": ["acute", "planned"],
    "priority": ["low", "normal", "high", "critical"],
    "events": ["guide_viewed", "guide_started", "node_viewed", "answer_selected", "guide_completed", "guide_abandoned", "result_reached", "cta_viewed", "cta_clicked", "outage_displayed", "outage_clicked", "wpform_displayed", "wpform_started", "wpform_submitted", "restart_clicked", "back_clicked"],
    "import_strategies": ["copy", "update", "skip"],
    "schema_versions_import": ["1.0", "2.0"], "schema_version_export": "2.0"
  },
  "options": ["finet_ts_settings", "finet_ts_demo_installed", "finet_ts_schema_version", "finet_ts_db_version", "finet_ts_upgrade_notice", "finet_ts_migration_log", "wpfinet_outage_rewrite_version"],
  "transients": ["finet_ts_activation_notice", "finet_ts_import_{uuid}", "wpfinet_outages_{md5}", "wpfinet_event_rate_{md5}"],
  "tables": ["{prefix}wpfinet_sessions", "{prefix}wpfinet_events"],
  "capabilities": ["manage_wpfinet", "manage_wpfinet_guides", "publish_wpfinet_guides", "manage_wpfinet_outages", "publish_wpfinet_outages", "view_wpfinet_statistics", "manage_wpfinet_settings"],
  "admin_slugs": ["admin.php?page=wpfinet", "edit.php?post_type=finet_ts_guide", "post-new.php?post_type=finet_ts_guide", "edit.php?post_type=wpfinet_outage", "post-new.php?post_type=wpfinet_outage", "admin.php?page=wpfinet-statistics", "admin.php?page=finet-ts-import-export", "admin.php?page=finet-ts-import-format", "admin.php?page=finet-ts-settings"],
  "client_storage": { "cookies": [], "sessionStorage": ["wpfinet_analytics_session", "wpfinet_banner_dismissed_{version}"] },
