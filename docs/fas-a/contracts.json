  "public_urls_from_user": ["https://dev.finet.se/", "https://dev.finet.se/tjansteguide/#/serviceguide/", "https://dev.finet.se/home/kundservice/", "https://dev.finet.se/fragor-och-svar/", "https://dev.finet.se/kontakta-oss/", "/tjanster", "/kontakta-oss"]
